<!-- pages/sichuan/index.wxml — 川麻积分 -->

<view class="container">
  <!-- 联机房间状态 -->
  <view class="room-banner {{room ? 'active' : ''}} {{room && !roomConnected ? 'offline' : ''}}" bindtap="openRoomPanel">
    <view class="room-banner-main">
      <text class="room-banner-title">{{room ? ('川麻房间 ' + room.roomCode) : '川麻联机房间'}}</text>
      <text class="room-banner-status" wx:if="{{room}}">{{room.status === 'ended' ? '已结束 · 只读' : (roomConnected && roomOnline ? '实时同步中' : '等待连接')}}</text>
      <text class="room-banner-status" wx:else>{{roomConfigured ? '创建或输入房间码加入' : '配置云环境后启用'}}</text>
    </view>
    <view class="room-banner-action">{{room ? '管理' : '进入'}} ›</view>
  </view>

  <!-- ═══ 十字牌桌 ═══ -->
  <view class="table-board sichuan-board">
    <view class="table-corner corner-tl">
      <text class="corner-label">模式</text>
      <text class="corner-value">川麻</text>
    </view>
    <view class="table-corner corner-tr">
      <text class="corner-label">人数</text>
      <text class="corner-value">4 人</text>
    </view>
    <view class="table-corner corner-bl">
      <text class="corner-label">记录</text>
      <text class="corner-value">{{game.history.length}} 笔</text>
    </view>
    <view class="table-corner corner-br">
      <text class="corner-label">状态</text>
      <text class="corner-value">{{game.history.length ? '进行中' : '待开局'}}</text>
    </view>

    <view class="table-center sichuan-center">
      <view class="center-kicker">即时结算</view>
      <view class="center-title">川麻积分</view>
      <view class="center-sub">四人零和计分</view>
    </view>

    <view
      wx:for="{{game.players}}"
      wx:key="index"
      class="player-card seat-{{seatClasses[index]}} sichuan-player"
      data-index="{{index}}"
      bindtap="openPlayerSetup"
    >
      <view wx:if="{{room}}" class="room-player-avatar">
        <image wx:if="{{roomSeatViews[index].avatarFileId}}" class="room-player-avatar-image" src="{{roomSeatViews[index].avatarFileId}}" mode="aspectFill" />
        <text wx:else>{{roomSeatViews[index].avatarText}}</text>
      </view>
      <view class="seat-label">{{seats[index]}}</view>
      <view class="name">{{item.name}}</view>
      <view class="points sichuan-points">{{item.score >= 0 ? '+' : ''}}{{item.score}}</view>
      <view wx:if="{{item.missingSuit}}" class="missing-badge missing-{{item.missingSuit}}">
        <text class="missing-prefix">缺</text>
        <text class="missing-suit">{{item.missingSuit === 'm' ? '万' : item.missingSuit === 'p' ? '筒' : '索'}}</text>
      </view>
    </view>
  </view>

  <!-- ═══ 操作按钮 ═══ -->
  <view wx:if="{{room && !roomWritable && room.status === 'active'}}" class="room-write-warning">{{roomOnline ? '正在连接房间，暂时不能提交操作' : '网络已断开，离线操作不会提交'}}</view>
  <view class="sichuan-actions">
    <view class="btn-row sichuan-score-actions">
      <button class="btn" bindtap="openWin" disabled="{{room && !roomWritable}}">胡牌积分</button>
      <button class="btn btn-secondary" bindtap="openGang" disabled="{{room && !roomWritable}}">杠分</button>
      <button class="btn btn-secondary" bindtap="openPenalty" disabled="{{room && !roomWritable}}">罚分</button>
    </view>
    <view class="table-setup-hint">点击东、南、西、北任一玩家卡片修改该玩家信息</view>
    <view class="toolbar">
      <button class="btn btn-danger btn-small" bindtap="undo" disabled="{{room && !roomWritable}}">撤销</button>
      <button class="btn btn-danger btn-small" bindtap="openHistory">记录</button>
      <button class="btn btn-danger btn-small" bindtap="resetGame" disabled="{{room && (!roomWritable || !room.isHost)}}">重置</button>
    </view>
  </view>
  <view class="rights-banner" bindtap="copyContact">
    <text class="rights-owner">© 2026 Lisang</text>
    <text class="rights-contact">权利与合作联系 · lisangcode@outlook.com</text>
  </view>
</view>

<!-- ═══ 川麻房间 ═══ -->
<view wx:if="{{showRoom}}" class="overlay tab-safe-overlay" bindtap="handleOverlayTap" data-id="showRoom">
  <scroll-view scroll-y class="modal room-modal tab-safe-scroll-modal">
    <view class="modal-close room-panel-close" bindtap="closeRoomPanel">✕</view>
    <view class="modal-title">{{room ? ('川麻房间 ' + room.roomCode) : '川麻联机房间'}}</view>

    <view wx:if="{{!roomConfigured}}" class="room-config-hint">
      房间代码已经就绪。请先在 <text class="code-text">miniprogram/config.js</text> 填写微信云开发 envId，并重新部署 <text class="code-text">mahjong-room</text> 云函数。
    </view>

    <block wx:if="{{!room}}">
      <view class="seg-group room-mode-tabs">
        <view class="seg-btn {{roomPanelMode === 'create' ? 'active' : ''}}" data-mode="create" bindtap="switchRoomPanel">创建房间</view>
        <view class="seg-btn {{roomPanelMode === 'join' ? 'active' : ''}}" data-mode="join" bindtap="switchRoomPanel">加入房间</view>
      </view>

      <view class="label">微信昵称</view>
      <input class="setup-name-input serif-input" type="nickname" value="{{roomNickname}}" bindinput="onRoomNicknameInput" maxlength="12" placeholder="选择或填写昵称" />
      <view class="room-profile-picker-row">
        <button class="room-avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseRoomAvatar" loading="{{roomAvatarUploading}}" disabled="{{roomAvatarUploading}}">
          <image wx:if="{{roomAvatarFileId}}" class="room-avatar-picker-image" src="{{roomAvatarFileId}}" mode="aspectFill" />
          <text wx:else class="room-avatar-picker-placeholder">选头像</text>
        </button>
        <view class="room-avatar-picker-copy">
          <text class="room-avatar-picker-title">房间头像（可选）</text>
          <text class="room-avatar-picker-desc">由你主动选择，进入房间后显示在玩家卡片中</text>
        </view>
      </view>
      <view class="room-privacy-hint">昵称和头像需要你主动确认；OpenID 只用于认回座位，不会显示给其他玩家。</view>

      <block wx:if="{{roomPanelMode === 'create'}}">
        <view class="room-preview-title">川麻四人房 · 选择座位</view>
        <view class="room-seat-grid">
          <view wx:for="{{roomSeatOptions}}" wx:key="index" class="room-seat-option {{roomSeatIndex === item.index ? 'active' : ''}}" data-index="{{item.index}}" bindtap="selectRoomSeat">
            <text class="room-seat-wind">{{item.label}}</text>
            <text>创建者</text>
          </view>
        </view>
        <button class="btn room-primary" bindtap="createRoom" loading="{{roomBusy}}" disabled="{{roomBusy || !roomConfigured}}">创建并进入</button>
      </block>

      <block wx:if="{{roomPanelMode === 'join'}}">
        <view class="label">6 位房间码</view>
        <view class="room-code-row">
          <input class="setup-name-input serif-input room-code-input" value="{{joinRoomCode}}" bindinput="onJoinRoomCodeInput" maxlength="6" placeholder="例如 8KMPQ2" />
          <button class="btn btn-secondary btn-small" bindtap="inspectJoinRoom" loading="{{roomBusy}}" disabled="{{roomBusy || !roomConfigured}}">查询</button>
        </view>
        <block wx:if="{{joinPreview}}">
          <view class="room-preview-title">川麻四人房 · 选择空座加入</view>
          <view class="room-seat-grid">
            <view wx:for="{{roomSeatOptions}}" wx:key="index" class="room-seat-option {{item.occupied ? 'occupied' : ''}} {{joinSeatIndex === item.index ? 'active' : ''}}" data-index="{{item.index}}" data-join="true" bindtap="selectRoomSeat">
              <text class="room-seat-wind">{{item.label}}</text>
              <text>{{item.occupied ? item.nickname : '空座'}}</text>
            </view>
          </view>
          <view wx:if="{{joinRoomFull}}" class="room-full-hint">房间已坐满。如果其中有你的保留座位，可以点击下方按钮恢复；否则加入会被拒绝。</view>
          <view class="room-privacy-hint">中途加入会继承该座位当前积分、定缺和对局记录。</view>
          <button class="btn room-primary" bindtap="joinRoom" loading="{{roomBusy}}" disabled="{{roomBusy || joinSeatIndex < 0}}">{{joinRoomFull ? '恢复我的座位' : '加入房间'}}</button>
        </block>
      </block>
    </block>

    <block wx:if="{{room}}">
      <view class="room-current-status {{room.status === 'ended' ? 'ended' : ''}}">
        <view>川麻四人房 · {{room.status === 'ended' ? '已结束，只读保留 30 天' : (roomConnected && roomOnline ? '实时同步中' : '等待重新连接')}}</view>
        <view>版本 {{room.version}} · 你的座位 {{seats[room.mySeat]}}</view>
      </view>
      <view wx:if="{{room.status === 'active'}}" class="room-current-avatar-row">
        <button class="room-avatar-picker compact" open-type="chooseAvatar" bindchooseavatar="chooseRoomAvatar" loading="{{roomAvatarUploading}}" disabled="{{roomAvatarUploading || !roomWritable}}">
          <image wx:if="{{roomAvatarFileId}}" class="room-avatar-picker-image" src="{{roomAvatarFileId}}" mode="aspectFill" />
          <text wx:else class="room-avatar-picker-placeholder">选头像</text>
        </button>
        <text>点击头像可更换，并实时同步给房间成员</text>
      </view>

      <view class="room-code-card" bindtap="copyRoomCode">
        <text class="room-code-label">房间码</text>
        <text class="room-code-value">{{room.roomCode}}</text>
        <text class="room-code-copy">点击复制</text>
      </view>
      <button class="btn btn-secondary" open-type="share">分享房间卡片</button>

      <view class="label">房间座位</view>
      <view class="room-member-list">
        <view wx:for="{{room.seats}}" wx:key="index" class="room-member-row">
          <view>
            <text class="room-member-seat">{{seats[item.index]}}</text>
            <text>{{item.nickname}}</text>
            <text wx:if="{{item.isMe}}" class="room-me-mark">我</text>
          </view>
          <button wx:if="{{room.isHost && item.occupied && !item.isMe && room.status === 'active'}}" class="room-release-btn" data-index="{{item.index}}" bindtap="releaseRoomSeat" disabled="{{roomBusy}}">释放</button>
          <button wx:elif="{{item.isMe && room.status === 'active'}}" class="room-move-btn" bindtap="toggleMoveSeat" disabled="{{roomBusy || !roomWritable}}">换座</button>
          <text wx:elif="{{!item.occupied}}" class="room-empty-mark">空座</text>
        </view>
      </view>

      <block wx:if="{{moveSeatChoosing && room.status === 'active'}}">
        <view class="label">换座到空座</view>
        <view class="room-seat-grid">
          <view wx:for="{{room.seats}}" wx:key="index" class="room-seat-option {{item.occupied ? 'occupied' : ''}} {{moveSeatTarget === item.index ? 'active' : ''}}" data-index="{{item.index}}" bindtap="selectMoveSeatTarget">
            <text class="room-seat-wind">{{seats[item.index]}}</text>
            <text>{{item.occupied ? item.nickname : '空座'}}</text>
          </view>
        </view>
        <view class="room-move-actions">
          <button class="btn btn-secondary btn-small" bindtap="toggleMoveSeat" disabled="{{roomBusy}}">取消</button>
          <button class="btn btn-small" bindtap="confirmMoveSeat" disabled="{{roomBusy || moveSeatTarget < 0}}">换座到这里</button>
        </view>
      </block>

      <view wx:if="{{room.lastAction}}" class="room-last-action">最近：{{room.lastAction.summary}}</view>

      <view class="modal-actions room-actions">
        <view class="room-management-row">
          <button class="btn btn-secondary" bindtap="leaveRoom">返回本地计分</button>
          <button wx:if="{{room.isHost && room.status === 'active'}}" class="btn btn-danger" bindtap="endRoom" disabled="{{roomBusy || !roomWritable}}">结束房间</button>
        </view>
        <button class="btn room-panel-dismiss" bindtap="closeRoomPanel">关闭</button>
      </view>
    </block>

    <button wx:if="{{!room}}" class="btn btn-secondary room-close" bindtap="closeRoomPanel">关闭</button>
  </scroll-view>
</view>

<!-- ═══ 胡牌弹窗 ═══ -->
<view wx:if="{{showWin}}" class="overlay tab-safe-overlay">
  <scroll-view scroll-y class="modal sichuan-win-modal tab-safe-scroll-modal">
    <view class="modal-title">🀄 胡牌积分</view>

    <!-- 收分玩家 -->
    <view class="label">收分玩家</view>
    <view class="seg-group seg-one-line player-select-row">
      <view
        wx:for="{{game.players}}"
        wx:key="index"
        class="seg-btn {{winReceiver === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="selectWinReceiver"
      >{{seats[index]}} · {{item.name}}</view>
    </view>

    <!-- 付款玩家 (多选) -->
    <view class="label">付款玩家（可多选）</view>
    <view class="seg-group seg-one-line player-select-row">
      <view
        wx:for="{{game.players}}"
        wx:key="index"
        wx:if="{{index !== winReceiver}}"
        class="seg-btn {{winPayers[index] ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="toggleWinPayer"
      >{{seats[index]}} · {{item.name}}</view>
    </view>
    <view wx:if="{{winPayerCount}}" style="font-size:22rpx;color:#8a8470;margin-top:4rpx">
      已选 {{winPayerCount}} 人
    </view>

    <!-- 番型选择 -->
    <view class="label">番型组合</view>
    <view class="fan-help">点击选择，长按查看牌型示例</view>
    <view wx:for="{{fanGroups}}" wx:key="label" style="margin-bottom:12rpx">
      <view style="font-size:22rpx;color:#8a8470;margin-bottom:8rpx">{{item.label}}</view>
      <view class="fan-chip-grid">
        <view
          wx:for="{{item.types}}"
          wx:key="id"
          class="seg-btn sch-fan-btn {{item.selected ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="toggleWinFan"
          bindlongpress="showFanExample"
        ><text class="fan-name">{{item.name}}</text><text class="fan-value">{{item.fan}}番</text></view>
      </view>
    </view>

    <!-- 根数 -->
    <view class="label">根数（四张一样未杠）</view>
    <view class="seg-group root-options" style="max-width:500rpx">
      <view
        wx:for="{{[0,1,2,3,4]}}"
        wx:key="*this"
        class="seg-btn {{winRootCount === item ? 'active' : ''}}"
        style="flex:1"
        data-value="{{item}}"
        bindtap="setWinRootCount"
      >{{item}}根</view>
    </view>

    <!-- 底分 + 封顶 -->
    <view class="sichuan-opts-row">
      <view style="flex:1">
        <view class="label">底分</view>
        <view class="seg-group">
          <view
            wx:for="{{baseScoreOptions}}"
            wx:key="*this"
            class="seg-btn {{winBaseScore === item ? 'active' : ''}}"
            style="flex:1"
            data-value="{{item}}"
            bindtap="setWinBaseScore"
          >{{item}}</view>
        </view>
      </view>
      <view style="flex:1">
        <view class="label">封顶</view>
        <view class="seg-group">
          <view
            wx:for="{{fanCapOptions}}"
            wx:key="*this"
            class="seg-btn {{winFanCap === item ? 'active' : ''}}"
            style="flex:1"
            data-value="{{item}}"
            bindtap="setWinFanCap"
          >{{item}}番</view>
        </view>
      </view>
    </view>

    <!-- 预览 -->
    <view wx:if="{{winFanPreview}}" class="result-box sichuan-result">
      <view class="detail">{{winFanPreview.label}}</view>
      <view class="points">{{winFanPreview.fan}}番</view>
      <view class="detail" style="margin-top:8rpx">
        每人 {{winFanPreview.amountPerPayer}} 分
        <text wx:if="{{winPayerCount}}"> · 合计 {{winFanPreview.total}} 分</text>
      </view>
    </view>

    <view class="modal-actions">
      <button class="btn btn-secondary" bindtap="closeWin">取消</button>
      <button class="btn" bindtap="confirmWin">确认结算</button>
    </view>
  </scroll-view>
</view>

<!-- ═══ 番型示例 ═══ -->
<view wx:if="{{showFanExample && fanExample}}" class="overlay tab-safe-overlay fan-example-overlay" bindtap="closeFanExample">
  <view class="modal compact-modal fan-example-modal" catchtap="noop">
    <view class="modal-title">{{fanExample.name}} · {{fanExample.fan}}番</view>
    <view class="fan-example-text">{{fanExample.exampleText}}</view>
    <view wx:if="{{fanExample.exampleImages.length}}" class="fan-example-tiles">
      <image wx:for="{{fanExample.exampleImages}}" wx:key="key" class="fan-example-tile {{item.isHaku ? 'haku-tile' : ''}}" src="{{item.src}}" mode="aspectFit" />
    </view>
    <view wx:else class="fan-example-note">这是和牌时机或附加条件，不对应固定手牌结构。</view>
    <button class="btn btn-secondary fan-example-close" bindtap="closeFanExample">知道了</button>
  </view>
</view>

<!-- ═══ 杠分弹窗 ═══ -->
<view wx:if="{{showGang}}" class="overlay tab-safe-overlay">
  <view class="modal compact-modal">
    <view class="modal-title">杠分</view>
    <view class="label">杠牌者</view>
    <view class="seg-group seg-one-line player-select-row">
      <view
        wx:for="{{game.players}}"
        wx:key="index"
        class="seg-btn {{gangReceiver === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="selectGangReceiver"
      >{{seats[index]}} · {{item.name}}</view>
    </view>
    <view class="label">每人支付金额</view>
    <input
      class="sichuan-input"
      type="digit"
      placeholder="输入金额"
      value="{{gangAmount}}"
      bindinput="onGangAmountInput"
    />
    <view wx:if="{{gangAmount}}" class="settlement-preview">
      {{seats[gangReceiver]}} 共收 {{gangAmount * 3}} 分（3人 × {{gangAmount}}）
    </view>
    <view class="modal-actions">
      <button class="btn btn-secondary" bindtap="closeGang">取消</button>
      <button class="btn" bindtap="confirmGang">确认</button>
    </view>
  </view>
</view>

<!-- ═══ 罚分弹窗 ═══ -->
<view wx:if="{{showPenalty}}" class="overlay tab-safe-overlay">
  <scroll-view scroll-y class="modal penalty-modal tab-safe-scroll-modal">
    <view class="modal-close" bindtap="closePenalty">✕</view>
    <view class="modal-title">罚分</view>

    <view class="label">谁送分</view>
    <view class="seg-group seg-one-line player-select-row">
      <view
        wx:for="{{game.players}}"
        wx:key="index"
        class="seg-btn {{penaltyPayer === index ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="selectPenaltyPayer"
      >{{seats[index]}} · {{item.name}}</view>
    </view>

    <view class="label">谁收分（可多选）</view>
    <view class="seg-group seg-one-line player-select-row">
      <view
        wx:for="{{game.players}}"
        wx:key="index"
        wx:if="{{index !== penaltyPayer}}"
        class="seg-btn {{penaltyReceivers[index] ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="togglePenaltyReceiver"
      >{{seats[index]}} · {{item.name}}</view>
    </view>

    <view class="label">罚分情况</view>
    <view class="penalty-type-grid">
      <view
        wx:for="{{penaltyTypes}}"
        wx:key="id"
        class="seg-btn penalty-type-btn {{penaltyTypeId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectPenaltyType"
      >{{item.name}}</view>
    </view>
    <view class="penalty-rule-card">
      <view class="penalty-rule-title">{{penaltyType.name}}：什么时候罚</view>
      <view class="penalty-rule-text">{{penaltyType.situation}}</view>
      <view class="penalty-rule-title">如何罚</view>
      <view class="penalty-rule-text">{{penaltyType.rule}}</view>
      <view class="penalty-rule-note">川麻地区规则差异较大，实际金额以开局约定为准。</view>
    </view>

    <view class="label">每位收分玩家获得</view>
    <input
      class="sichuan-input"
      type="digit"
      placeholder="输入罚分金额"
      value="{{penaltyAmount}}"
      bindinput="onPenaltyAmountInput"
    />
    <view wx:if="{{penaltyAmount && penaltyReceiverCount}}" class="settlement-preview">
      {{seats[penaltyPayer]}} 共付 {{penaltyAmount * penaltyReceiverCount}} 分（{{penaltyReceiverCount}}人 × {{penaltyAmount}}）
    </view>
    <view class="modal-actions">
      <button class="btn btn-secondary" bindtap="closePenalty">取消</button>
      <button class="btn" bindtap="confirmPenalty">确认罚分</button>
    </view>
  </scroll-view>
</view>

<!-- ═══ 单个玩家设置弹窗 ═══ -->
<view wx:if="{{showSetup}}" class="overlay tab-safe-overlay" bindtap="handleOverlayTap" data-id="showSetup">
  <view class="modal compact-modal setup-modal">
    <view class="modal-title">设置{{seats[setupPlayerIndex]}}家</view>
    <view wx:if="{{room}}" class="room-privacy-hint setup-room-hint">联网房间姓名由座位昵称决定，本次只同步该玩家的定缺状态。</view>

    <view class="label">玩家姓名</view>
    <input
      class="setup-name-input serif-input sichuan-serif-input"
      value="{{setupName}}"
      bindinput="onSetupNameInput"
      placeholder="玩家姓名"
      maxlength="12"
      disabled="{{room}}"
    />

    <view class="label">定缺</view>
    <view class="seg-group seg-one-line setup-suit-options">
      <view class="seg-btn {{!setupMissingSuit ? 'active' : ''}}" data-suit="none" bindtap="setMissingSuit">未定</view>
      <view class="seg-btn {{setupMissingSuit === 'm' ? 'active' : ''}}" data-suit="m" bindtap="setMissingSuit">缺万</view>
      <view class="seg-btn {{setupMissingSuit === 'p' ? 'active' : ''}}" data-suit="p" bindtap="setMissingSuit">缺筒</view>
      <view class="seg-btn {{setupMissingSuit === 's' ? 'active' : ''}}" data-suit="s" bindtap="setMissingSuit">缺索</view>
    </view>

    <view class="modal-actions setup-modal-actions">
      <button class="btn btn-secondary" bindtap="closeSetup">取消</button>
      <button class="btn" bindtap="confirmSetup" disabled="{{room && !roomWritable}}">{{room ? '同步' : '保存'}}</button>
    </view>
  </view>
</view>

<!-- ═══ 记录列表 ═══ -->
<view wx:if="{{showHistory}}" class="overlay tab-safe-overlay" bindtap="handleOverlayTap" data-id="showHistory">
  <scroll-view scroll-y class="modal history-modal tab-safe-scroll-modal">
    <view class="modal-title">对局记录</view>
    <view class="sichuan-scoreboard">
      <view wx:for="{{game.players}}" wx:key="index" class="scoreboard-item">
        <text class="sb-seat">{{seats[index]}}</text>
        <text class="sb-name">{{item.name}}</text>
        <text class="sb-score {{item.score >= 0 ? 'plus' : 'minus'}}">{{item.score >= 0 ? '+' : ''}}{{item.score}}</text>
      </view>
    </view>
    <view wx:if="{{game.history.length}}" class="sichuan-history">
      <view
        wx:for="{{historyList}}"
        wx:key="index"
        class="sichuan-history-item"
      >
        <view class="shi-header">
          <text class="shi-index">#{{item.index}}</text>
          <text class="shi-type">{{item.type}}</text>
          <text class="shi-receiver">{{item.receiver}} · {{item.receiverName}}</text>
          <text class="shi-amount">+{{item.amount}}分</text>
        </view>
        <view class="shi-detail">{{item.label}}</view>
      </view>
    </view>
    <view wx:else style="text-align:center;color:#aaa;padding:60rpx">暂无记录</view>
    <view class="modal-actions">
      <button class="btn btn-secondary" bindtap="closeHistory">关闭</button>
    </view>
  </scroll-view>
</view>
