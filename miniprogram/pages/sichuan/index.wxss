/* pages/sichuan/index.wxss — 川麻积分样式 */
@import "/utils/common.wxss";

/* ── 牌桌微调 ── */
.sichuan-board { border-color: #d8d1c3; }
.sichuan-center { border-color: #d8d1c3; background: rgba(255,255,255,.96); }
.center-title { color: #c96442; font-size: 28rpx; font-weight: 700; line-height: 1.35; white-space: nowrap; }
.center-sub { margin-top: 4rpx; color: #8a8470; font-size: 18rpx; }

/* ── 玩家卡片 ── */
.sichuan-player { border-color: #d8d1c3; }
.sichuan-player .name { max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sichuan-points { font-size: 34rpx; white-space: nowrap; font-variant-numeric: tabular-nums; }

/* ── 缺门徽章 ── */
.missing-badge {
  position: absolute;
  left: 50%;
  bottom: -15rpx;
  transform: translateX(-50%);
  padding: 3rpx 13rpx;
  border-radius: 9rpx;
  font-size: 17rpx;
  font-weight: 600;
  white-space: nowrap;
}
.missing-m {
  background: #e8f0e0;
  color: #4a6e3a;
  border: 1rpx solid #b8d4a0;
}
.missing-p {
  background: #e0e8f0;
  color: #3a4e6e;
  border: 1rpx solid #a0b8d4;
}
.missing-s {
  background: #f0e0e0;
  color: #6e3a3a;
  border: 1rpx solid #d4a0a0;
}

/* ── 操作区 ── */
.sichuan-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
}

/* ── 胡牌弹窗番型按钮 ── */
.sch-fan-btn {
  min-width: 0;
  width: 100%;
  font-size: 24rpx;
  min-height: 72rpx;
  padding: 12rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  white-space: nowrap;
}
.fan-chip-grid { display: grid; grid-template-columns: 1fr; gap: 10rpx; }
.fan-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.fan-value { flex-shrink: 0; font-size: 20rpx; opacity: .72; }
.fan-help { margin: -4rpx 0 14rpx; color: #a09a87; font-size: 21rpx; }

.root-options { flex-wrap: nowrap; }
.root-options .seg-btn { min-width: 0; flex: 1; padding-left: 4rpx; padding-right: 4rpx; white-space: nowrap; }

/* ── 底分/封顶行 ── */
.sichuan-opts-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}
.sichuan-opts-row > view { width: 100%; min-width: 0; }
.sichuan-opts-row .seg-btn { min-width: 0; padding-left: 8rpx; padding-right: 8rpx; white-space: nowrap; }

/* ── 计算结果 ── */
.sichuan-result {
  border-color: #c96442;
  background: #fef9f5;
}
.sichuan-result .points {
  color: #c96442;
}
.sichuan-win-modal, .history-modal { max-height: 92vh; }
.setup-modal { max-height: 88vh; overflow-y: auto; }
.settlement-preview { font-size: 24rpx; color: #8a8470; margin: 10rpx 0; line-height: 1.6; text-align: center; word-break: keep-all; }

/* ── 输入框 ── */
.sichuan-input {
  width: 100%;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  background: #fff;
  border: 2rpx solid #e8e5d8;
  border-radius: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #3d3929;
  text-align: center;
  box-sizing: border-box;
}

/* ── 设置面板 ── */
.setup-player-row {
  background: #fff;
  border: 2rpx solid #e8e5d8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.setup-player-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.setup-seat {
  font-size: 30rpx;
  font-weight: 700;
  color: #c96442;
  min-width: 48rpx;
}
.setup-name-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  background: #faf8f2;
  border: 2rpx solid #e8e5d8;
  border-radius: 14rpx;
  font-size: 28rpx;
  color: #3d3929;
  box-sizing: border-box;
}

/* ── 番型示例 ── */
.fan-example-overlay { z-index: 1300; }
.fan-example-modal { max-width: 640rpx; }
.fan-example-text { color: #746e5c; font-size: 25rpx; line-height: 1.7; text-align: center; }
.fan-example-tiles { display: flex; flex-wrap: nowrap; justify-content: center; gap: 2rpx; margin: 24rpx -12rpx 0; overflow: hidden; }
.fan-example-tile { flex: 1 1 0; min-width: 0; max-width: 42rpx; height: 58rpx; }
.fan-example-note { margin-top: 24rpx; padding: 18rpx; border-radius: 14rpx; background: #f1eee4; color: #8a8470; font-size: 23rpx; line-height: 1.6; text-align: center; }
.fan-example-close { width: 100%; margin-top: 24rpx; }
.missing-suit-btn {
  min-width: 80rpx;
  font-size: 24rpx;
}

/* ── 记分板 ── */
.sichuan-scoreboard {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin-bottom: 24rpx;
}
.scoreboard-item {
  background: #fff;
  border: 2rpx solid #e8e5d8;
  border-radius: 14rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}
.sb-seat {
  display: block;
  font-size: 20rpx;
  color: #c96442;
  font-weight: 500;
}
.sb-name {
  display: block;
  font-size: 24rpx;
  color: #3d3929;
  margin: 4rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sb-score {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}
.sb-score.plus { color: #5a7a4a; }
.sb-score.minus { color: #c96442; }

/* ── 记录列表 ── */
.sichuan-history {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.sichuan-history-item {
  background: #fff;
  border: 2rpx solid #e8e5d8;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}
.shi-header {
  display: grid;
  grid-template-columns: auto auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 12rpx;
}
.shi-index {
  font-size: 20rpx;
  color: #b8b299;
  min-width: 36rpx;
  flex-shrink: 0;
}
.shi-type {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: #c96442;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  white-space: nowrap;
}
.shi-receiver {
  font-size: 26rpx;
  font-weight: 600;
  color: #3d3929;
  flex: 1;
  min-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.shi-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #5a7a4a;
  flex-shrink: 0;
  white-space: nowrap;
}
.shi-detail {
  font-size: 22rpx;
  color: #8a8470;
  margin-top: 8rpx;
  padding-left: 0;
  line-height: 1.6;
  overflow-wrap: break-word;
}
