/* pages/tutorial/index.wxss — 教学馆 */
@import "/utils/common.wxss";

/* ===== 继续学习 ===== */
.hero {
  background: linear-gradient(145deg, #4a6741, #2d4a2a);
  border-radius: 26rpx;
  padding: 28rpx 30rpx 30rpx;
  color: #f0f5ec;
}
.hero-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12rpx; }
.hero-kicker { font-size: 22rpx; letter-spacing: 2rpx; opacity: .75; }
.hero-progress-text { font-size: 22rpx; opacity: .85; }
.progress-bar { height: 10rpx; background: rgba(255,255,255,.2); border-radius: 99rpx; overflow: hidden; }
.progress-fill { height: 100%; background: #8fbc7a; border-radius: inherit; transition: width .3s ease; min-width: 0; }
.hero-label { margin-top: 24rpx; font-size: 22rpx; opacity: .75; }
.hero-title { margin-top: 6rpx; font-size: 36rpx; font-weight: 700; line-height: 1.35; }
.hero-sub { margin-top: 8rpx; font-size: 23rpx; line-height: 1.6; opacity: .85; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.hero-btn { margin: 22rpx 0 0; width: 100%; padding: 18rpx 0; border-radius: 16rpx; background: #f0f5ec; color: #2d4a2a; font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.hero-btn::after { border: 0; }

/* ===== 推荐练习 ===== */
.recommend-row { display: flex; align-items: center; flex-wrap: wrap; gap: 10rpx; margin-top: 18rpx; }
.recommend-label { color: #5a7a4a; font-size: 22rpx; font-weight: 700; }
.recommend-chip { padding: 8rpx 18rpx; border-radius: 99rpx; background: #e5f0df; color: #4f6743; font-size: 22rpx; }

/* ===== 分段切换 ===== */
.home-tabs { display: flex; gap: 6rpx; margin: 24rpx 0 18rpx; padding: 6rpx; border-radius: 18rpx; background: #ebe7da; }
.home-tab { flex: 1; padding: 14rpx 0; border-radius: 14rpx; color: #746e5c; font-size: 26rpx; text-align: center; }
.home-tab.active { background: #fff; color: var(--accent, #c96442); font-weight: 700; box-shadow: 0 2rpx 8rpx rgba(61,57,41,.08); }

/* ===== 课程目录：按阶段分组 ===== */
.stage-list { display: flex; flex-direction: column; gap: 12rpx; }
.stage-group { background: #fff; border: 2rpx solid #e8e5d8; border-radius: 18rpx; overflow: hidden; }
.stage-group.current { border-color: #cfdcc6; }
.stage-head { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 22rpx; }
.stage-title { color: #3d3929; font-size: 27rpx; font-weight: 700; }
.stage-range { flex: 1; color: #aaa28f; font-size: 21rpx; }
.stage-count { color: #8a8470; font-size: 22rpx; }
.stage-count.done { color: #5a7a4a; font-weight: 700; }
.stage-arrow { width: 24rpx; color: #b8b299; font-size: 22rpx; text-align: center; }
.lesson-row { display: flex; align-items: center; gap: 14rpx; padding: 16rpx 22rpx; border-top: 2rpx solid #f1eee5; }
.lesson-row:active { background: #faf8f2; }
.lesson-row.current { background: #f6f9f3; }
.lesson-row-num { flex: 0 0 auto; width: 44rpx; height: 44rpx; border-radius: 50%; background: #f5eee7; color: var(--accent, #c96442); font-size: 22rpx; font-weight: 700; line-height: 44rpx; text-align: center; }
.lesson-row-num.learned { background: #e5f0df; color: #4f6743; }
.lesson-row-title { flex: 1; min-width: 0; overflow: hidden; color: #3d3929; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.lesson-row-tag { flex: 0 0 auto; padding: 4rpx 12rpx; border-radius: 99rpx; background: #5a7a4a; color: #fff; font-size: 19rpx; }
.lesson-arrow { color: #b8b299; font-size: 34rpx; line-height: 1; }

/* ===== 专项训练 ===== */
.training-list { display: flex; flex-direction: column; gap: 12rpx; }
.quiz-entry { display: flex; align-items: center; gap: 16rpx; padding: 22rpx; border: 2rpx solid #e8e5d8; border-radius: 18rpx; background: #fff; }
.quiz-entry.recommended { border-color: #b9cfa9; background: #f8fbf5; }
.quiz-entry:active { transform: scale(.98); }
.quiz-entry-icon { min-width: 56rpx; font-size: 40rpx; text-align: center; }
.quiz-entry-info { flex: 1; min-width: 0; }
.quiz-entry-title { color: #3d3929; font-size: 28rpx; font-weight: 700; }
.quiz-entry-tag { margin-left: 10rpx; padding: 2rpx 10rpx; border-radius: 99rpx; background: #5a7a4a; color: #fff; font-size: 18rpx; font-weight: 600; vertical-align: middle; }
.quiz-entry-desc { margin-top: 4rpx; color: #8a8470; font-size: 22rpx; }
.quiz-entry-hint { margin-top: 4rpx; color: #aaa28f; font-size: 20rpx; }
.quiz-entry.recommended .quiz-entry-hint { color: #5a7a4a; }

/* ===== 工具 ===== */
.nav-cards { display: flex; flex-direction: column; gap: 12rpx; }
.nav-card { display: flex; align-items: center; gap: 16rpx; padding: 22rpx; border: 2rpx solid #e8e5d8; border-radius: 18rpx; background: #fff; }
.nav-card:active { transform: scale(.98); }
.nav-card-icon { min-width: 52rpx; font-size: 36rpx; text-align: center; }
.nav-card-info { flex: 1; min-width: 0; }
.nav-card-title { color: #3d3929; font-size: 28rpx; font-weight: 700; }
.nav-card-desc { margin-top: 4rpx; color: #8a8470; font-size: 22rpx; }
.nav-card-arrow { color: #b8b299; font-size: 32rpx; }

/* ===== 课程弹窗 ===== */
.tutorial-modal {
  width: 100%; max-width: 680rpx; height: calc(100vh - 156rpx - env(safe-area-inset-bottom));
  max-height: 90vh; background: var(--surface, #faf9f3);
  border-radius: 30rpx; padding: 36rpx;
  box-sizing: border-box; display: flex; flex-direction: column; overflow: hidden;
  box-shadow: 0 18rpx 60rpx rgba(49,45,34,.24);
}
.lesson-scroll { flex: 1; min-height: 0; }
.lesson-eyebrow { color: var(--accent, #c96442); font-size: 22rpx; font-weight: 700; text-align: center; }
.lesson-title {
  font-size: 36rpx; font-weight: 700; text-align: center; color: #3d3929; margin: 12rpx 0;
}
.lesson-summary { color: #746e5c; font-size: 26rpx; line-height: 1.75; margin-bottom: 20rpx; }

.lesson-points { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 20rpx; }
.lesson-point-item {
  display: flex; gap: 10rpx; background: #fff; border: 2rpx solid #e8e5d8;
  border-radius: 14rpx; padding: 16rpx 20rpx; font-size: 24rpx; line-height: 1.6;
}
.point-bullet { color: var(--accent, #c96442); min-width: 24rpx; }

/* 术语释义 */
.lesson-terms { margin: 4rpx 0 20rpx; }
.lesson-terms-title { font-size: 22rpx; font-weight: 700; color: var(--accent, #c96442); margin-bottom: 10rpx; letter-spacing: 1rpx; }
.term-item {
  display: flex; gap: 12rpx; align-items: flex-start; padding: 12rpx 16rpx;
  background: #f7f4ec; border: 2rpx solid #e6e1d2; border-radius: 12rpx; margin-bottom: 8rpx;
}
.term-name { color: var(--accent, #c96442); font-weight: 700; font-size: 24rpx; flex: 0 0 auto; min-width: 132rpx; }
.term-def { color: #5a5748; font-size: 24rpx; line-height: 1.6; }

.lesson-tile-groups { margin-bottom: 20rpx; }
.tile-group { margin-bottom: 14rpx; }
.tile-group-label { font-size: 22rpx; color: #746e5c; margin-bottom: 8rpx; }
.tile-row-inline { display: flex; flex-wrap: nowrap; gap: 4rpx; padding: 12rpx; background: #eeeadd; border-radius: 14rpx; align-items: center; }
.lesson-tile-img { width: 34rpx; height: 46rpx; flex: 0 0 auto; border-radius: 4rpx; }
.lesson-win-tile { margin-left: 20rpx; }

.lesson-tip {
  display: flex; gap: 10rpx; border-left: 5rpx solid #5a7a4a;
  padding: 16rpx 20rpx; background: #f1f5ee; color: #536349;
  border-radius: 0 14rpx 14rpx 0; font-size: 22rpx; line-height: 1.65; margin-bottom: 8rpx;
}
.tip-icon { font-size: 24rpx; flex-shrink: 0; }

/* 章末小测 */
.lesson-check-card {
  margin-top: 24rpx; padding: 22rpx; background: #fff;
  border: 3rpx solid #d9e4d3; border-radius: 20rpx;
}
.lesson-check-heading { display: flex; justify-content: space-between; gap: 16rpx; align-items: flex-start; }
.lesson-check-kicker { color: #5a7a4a; font-size: 22rpx; font-weight: 700; }
.lesson-check-title { color: #8a8470; font-size: 21rpx; margin-top: 4rpx; }
.lesson-learned-badge {
  flex: 0 0 auto; padding: 8rpx 14rpx; border-radius: 99rpx;
  background: #edf4e9; color: #4f6743; font-size: 20rpx; font-weight: 700;
}
.lesson-check-question { margin: 20rpx 0 16rpx; color: #3d3929; font-size: 27rpx; font-weight: 600; line-height: 1.55; }
.lesson-check-options .quiz-option { padding: 16rpx 18rpx; font-size: 24rpx; }
.lesson-check-explanation { padding: 18rpx 0 0; }

/* 课程弹窗底部操作区：独立页脚条，避免压住滚动内容 */
.lesson-modal-actions {
  flex: 0 0 auto; margin-top: 16rpx; padding: 18rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #ece7db;
}
.lesson-modal-actions .btn { padding: 18rpx; font-size: 28rpx; }
.lesson-scroll-gap { height: 20rpx; }
/* 课程弹窗关闭按钮改为右上角（flex 容器里 float 失效，用 align-self 归位） */
.tutorial-modal .modal-close { align-self: flex-end; }

/* ===== 专项训练 ===== */
.quiz-modal { max-height: 94vh; }
.quiz-topic-heading { text-align: center; margin: 0 40rpx 18rpx; }
.quiz-topic-title { color: #3d3929; font-size: 32rpx; font-weight: 700; }
.quiz-topic-desc { color: #8a8470; font-size: 22rpx; margin-top: 6rpx; }
.quiz-progress { text-align: center; margin-bottom: 20rpx; font-size: 24rpx; color: #8a8470; }
.quiz-progress-bar {
  height: 10rpx; background: #e8e5d8; border-radius: 99rpx;
  margin-top: 10rpx; overflow: hidden;
}
.quiz-progress-fill { height: 100%; background: #5a7a4a; border-radius: inherit; transition: width .25s; }
.quiz-question { font-size: 30rpx; line-height: 1.55; margin-bottom: 24rpx; font-weight: 600; }
.quiz-options { display: flex; flex-direction: column; gap: 12rpx; }
.quiz-option {
  display: flex; align-items: center; gap: 14rpx;
  border: 2rpx solid #ded8c8; background: #fff; color: #3d3929;
  border-radius: 16rpx; padding: 20rpx; font-size: 26rpx;
}
.quiz-option.selected { border-color: var(--accent, #c96442); background: #fdf1eb; color: #a84e31; }
.quiz-option.correct { border-color: #5a7a4a; background: #edf4e9; color: #4f6743; }
.quiz-option.wrong { border-color: var(--accent, #c96442); background: #fbece7; color: #9e4f38; }
.option-letter { font-weight: 700; min-width: 36rpx; color: var(--accent, #c96442); }
.option-text { flex: 1; }

.quiz-explanation { margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx; }
.quiz-explanation-header { font-size: 26rpx; font-weight: 700; margin-bottom: 10rpx; }
.quiz-explanation-header.correct { color: #4f6743; }
.quiz-explanation-header.wrong { color: #9e4f38; }
.quiz-explanation-text { font-size: 24rpx; color: #746e5c; line-height: 1.65; margin-bottom: 18rpx; }
.quiz-submit-area { margin-top: 24rpx; }

.quiz-result { text-align: center; padding: 28rpx 0; }
.quiz-result-score { font-size: 72rpx; color: var(--accent, #c96442); font-weight: 700; }
.quiz-result-label { font-size: 26rpx; color: #8a8470; margin: 10rpx 0 18rpx; }
.quiz-result-text { font-size: 26rpx; color: #746e5c; line-height: 1.7; }
