/* pages/tutorial/index.wxss — 教学馆 */
@import "/utils/common.wxss";

/* ===== Hero ===== */
.hero {
  background: linear-gradient(145deg, #4a6741, #2d4a2a);
  border-radius: 26rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  color: #f0f5ec;
}
.hero-title { font-size: 40rpx; font-weight: 700; line-height: 1.3; margin-bottom: 12rpx; }
.hero-sub { font-size: 26rpx; opacity: 0.85; line-height: 1.6; margin-bottom: 28rpx; }

/* ===== 进度 ===== */
.progress-section { margin-top: 8rpx; }
.progress-bar {
  height: 12rpx; background: rgba(255,255,255,.2); border-radius: 99rpx; overflow: hidden;
}
.progress-fill {
  height: 100%; background: #8fbc7a; border-radius: inherit;
  transition: width 0.3s ease; min-width: 0;
}
.progress-text { font-size: 22rpx; opacity: 0.7; margin-top: 10rpx; }

/* ===== 区块标题 ===== */
.section-title {
  font-size: 32rpx; font-weight: 700; color: #3d3929;
  margin: 32rpx 0 18rpx;
}

/* ===== 课程列表 ===== */
.lesson-list { display: flex; flex-direction: column; gap: 14rpx; }
.lesson-card {
  position: relative; background: #fff; border: 2rpx solid #e8e5d8;
  border-radius: 20rpx; padding: 22rpx; display: flex; align-items: center; gap: 16rpx;
}
.lesson-card:active { transform: scale(.98); }
.lesson-card-inner {
  flex: 1; display: flex; align-items: center; gap: 16rpx; min-width: 0;
}
.lesson-number {
  min-width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center;
  border-radius: 50%; background: #f5eee7; color: #c96442; font-weight: 700; font-size: 22rpx;
}
.lesson-info { flex: 1; min-width: 0; overflow: hidden; }
.lesson-card-title {
  font-size: 28rpx; font-weight: 700; color: #3d3929;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lesson-card-summary {
  font-size: 22rpx; color: #918a76; margin-top: 4rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.lesson-arrow { color: #b8b299; font-size: 36rpx; }
.lesson-check {
  position: absolute; top: -6rpx; right: -6rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #5a7a4a; color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}

/* ===== 测验入口 ===== */
.quiz-entry {
  background: #fff; border: 2rpx solid #e8e5d8;
  border-radius: 20rpx; padding: 24rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.quiz-entry:active { transform: scale(.98); }
.quiz-entry-icon { font-size: 40rpx; min-width: 56rpx; text-align: center; }
.quiz-entry-info { flex: 1; }
.quiz-entry-title { font-size: 28rpx; font-weight: 700; color: #3d3929; }
.quiz-entry-desc { font-size: 22rpx; color: #8a8470; margin-top: 4rpx; }

/* ===== 导航卡片 ===== */
.nav-cards { display: flex; flex-direction: column; gap: 14rpx; }
.nav-card {
  background: #fff; border: 2rpx solid #e8e5d8;
  border-radius: 20rpx; padding: 24rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.nav-card:active { transform: scale(.98); }
.nav-card-icon { font-size: 36rpx; min-width: 52rpx; text-align: center; }
.nav-card-title { font-size: 28rpx; font-weight: 700; color: #3d3929; flex: 1; }
.nav-card-desc { font-size: 22rpx; color: #8a8470; margin-top: 4rpx; display: none; }
.nav-card-arrow { color: #b8b299; font-size: 32rpx; }

/* ===== 课程弹窗 ===== */
.tutorial-modal {
  width: 100%; max-width: 680rpx; max-height: 90vh; background: #faf9f3;
  border-radius: 30rpx; padding: 36rpx;
  box-sizing: border-box; display: flex; flex-direction: column;
  box-shadow: 0 18rpx 60rpx rgba(49,45,34,.24);
}
.lesson-scroll { flex: 1; max-height: 70vh; }
.lesson-eyebrow { color: #c96442; font-size: 22rpx; font-weight: 700; text-align: center; }
.lesson-title {
  font-size: 36rpx; font-weight: 700; text-align: center; color: #3d3929; margin: 12rpx 0;
}
.lesson-summary { color: #746e5c; font-size: 26rpx; line-height: 1.75; margin-bottom: 20rpx; }

.lesson-points { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 20rpx; }
.lesson-point-item {
  display: flex; gap: 10rpx; background: #fff; border: 2rpx solid #e8e5d8;
  border-radius: 14rpx; padding: 16rpx 20rpx; font-size: 24rpx; line-height: 1.6;
}
.point-bullet { color: #c96442; min-width: 24rpx; }

.lesson-tile-groups { margin-bottom: 20rpx; }
.tile-group { margin-bottom: 14rpx; }
.tile-group-label { font-size: 22rpx; color: #746e5c; margin-bottom: 8rpx; }
.tile-row-inline { display: flex; flex-wrap: wrap; gap: 6rpx; padding: 14rpx; background: #eeeadd; border-radius: 14rpx; }
.lesson-tile-img { width: 52rpx; height: 70rpx; border-radius: 4rpx; }

.lesson-tip {
  display: flex; gap: 10rpx; border-left: 5rpx solid #5a7a4a;
  padding: 16rpx 20rpx; background: #f1f5ee; color: #536349;
  border-radius: 0 14rpx 14rpx 0; font-size: 22rpx; line-height: 1.65;
}
.tip-icon { font-size: 24rpx; flex-shrink: 0; }
.lesson-modal-actions { margin-top: 24rpx; padding-bottom: env(safe-area-inset-bottom); }

/* ===== 测验 ===== */
.quiz-modal { max-height: 94vh; }
.quiz-progress { text-align: center; margin-bottom: 20rpx; font-size: 24rpx; color: #8a8470; }
.quiz-progress-bar {
  height: 10rpx; background: #e8e5d8; border-radius: 99rpx;
  margin-top: 10rpx; overflow: hidden;
}
.quiz-progress-fill { height: 100%; background: #5a7a4a; border-radius: inherit; transition: width .25s; }
.quiz-question { font-size: 30rpx; line-height: 1.55; margin-bottom: 24rpx; font-weight: 600; }
.quiz-options { display: flex; flex-direction: column; gap: 12rpx; }
.quiz-option {
  display: flex; align-items: center; gap: 14rpx;
  border: 2rpx solid #ded8c8; background: #fff; color: #3d3929;
  border-radius: 16rpx; padding: 20rpx; font-size: 26rpx;
}
.quiz-option.selected { border-color: #c96442; background: #fdf1eb; color: #a84e31; }
.quiz-option.correct { border-color: #5a7a4a; background: #edf4e9; color: #4f6743; }
.quiz-option.wrong { border-color: #c96442; background: #fbece7; color: #9e4f38; }
.option-letter { font-weight: 700; min-width: 36rpx; color: #c96442; }
.option-text { flex: 1; }

.quiz-explanation { margin-top: 20rpx; padding: 20rpx; border-radius: 16rpx; }
.quiz-explanation-header { font-size: 26rpx; font-weight: 700; margin-bottom: 10rpx; }
.quiz-explanation-header.correct { color: #4f6743; }
.quiz-explanation-header.wrong { color: #9e4f38; }
.quiz-explanation-text { font-size: 24rpx; color: #746e5c; line-height: 1.65; margin-bottom: 18rpx; }
.quiz-submit-area { margin-top: 24rpx; }

.quiz-result { text-align: center; padding: 28rpx 0; }
.quiz-result-score { font-size: 72rpx; color: #c96442; font-weight: 700; }
.quiz-result-label { font-size: 26rpx; color: #8a8470; margin: 10rpx 0 18rpx; }
.quiz-result-text { font-size: 26rpx; color: #746e5c; line-height: 1.7; }
