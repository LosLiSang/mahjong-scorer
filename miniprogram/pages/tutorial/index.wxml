<!-- pages/tutorial/index.wxml — 教学馆 -->

<view class="container">
  <!-- Hero -->
  <view class="hero">
    <view class="hero-title">从认牌到看懂点数</view>
    <view class="hero-sub">系统学习日麻基础，新手也能快速上手计分</view>
    <view class="progress-section">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressPercent}}%"></view>
      </view>
      <view class="progress-text">已学会 {{completedCount}} / {{totalLessons}} 章（{{progressPercent}}%）</view>
    </view>
  </view>

  <!-- 课程列表 -->
  <view class="section-title">📚 课程</view>
  <view class="lesson-list">
    <view
      wx:for="{{lessons}}"
      wx:key="id"
      class="lesson-card"
      data-id="{{item.id}}"
      bindtap="openLesson"
    >
      <view class="lesson-card-inner">
        <view class="lesson-number">第{{index + 1}}章</view>
        <view class="lesson-info">
          <view class="lesson-card-title-row">
            <view class="lesson-card-title">{{item.title}}</view>
            <view class="lesson-status-badge {{item.learned ? 'learned' : 'pending'}}">
              {{item.learned ? '已学会' : '未学会'}}
            </view>
          </view>
          <view class="lesson-card-summary">{{item.summary}}</view>
          <view class="lesson-card-status {{item.learned ? 'learned' : ''}}">
            {{item.learned ? '本章小测已通过' : '学习课程并完成章末小测'}}
          </view>
        </view>
      </view>
      <view class="lesson-arrow">›</view>
    </view>
  </view>

  <!-- 专项训练 -->
  <view class="section-title">🎯 专项训练</view>
  <view class="training-list">
    <view
      wx:for="{{trainingTopics}}"
      wx:key="id"
      class="quiz-entry"
      data-id="{{item.id}}"
      bindtap="openTraining"
    >
      <view class="quiz-entry-icon">{{item.icon}}</view>
      <view class="quiz-entry-info">
        <view class="quiz-entry-title">{{item.title}}</view>
        <view class="quiz-entry-desc">{{item.description}} · {{item.questions.length}} 题</view>
      </view>
      <view class="lesson-arrow">›</view>
    </view>
  </view>

  <!-- 工具入口 -->
  <view class="section-title">🧭 工具</view>
  <view class="nav-cards">
    <view class="nav-card" bindtap="goToYakuCatalog">
      <view class="nav-card-icon">📋</view>
      <view class="nav-card-title">役种图鉴</view>
      <view class="nav-card-desc">查看全部役种、番数与条件</view>
      <view class="nav-card-arrow">›</view>
    </view>
    <view class="nav-card" bindtap="goToScoringGuide">
      <view class="nav-card-icon">🧮</view>
      <view class="nav-card-title">算分详解</view>
      <view class="nav-card-desc">符数、番数、点数档位完全拆解</view>
      <view class="nav-card-arrow">›</view>
    </view>
  </view>
  <view class="rights-banner" bindtap="copyContact">
    <text class="rights-owner">© 2026 Lisang</text>
    <text class="rights-contact">权利与合作联系 · lisangcode@outlook.com</text>
  </view>
</view>

<!-- 课程弹窗 -->
<view wx:if="{{showLesson}}" class="overlay tab-safe-overlay" bindtap="closeLesson">
  <view class="tutorial-modal" catchtap="noop">
    <view class="modal-close" bindtap="closeLesson">✕</view>
    <scroll-view scroll-y class="lesson-scroll">
      <view class="lesson-eyebrow">{{activeLesson.eyebrow}}</view>
      <view class="lesson-title">{{activeLesson.title}}</view>
      <view class="lesson-summary">{{activeLesson.summary}}</view>

      <view wx:if="{{activeLesson.points.length}}" class="lesson-points">
        <view wx:for="{{activeLesson.points}}" wx:key="*this" class="lesson-point-item">
          <text class="point-bullet">•</text>
          <text>{{item}}</text>
        </view>
      </view>

      <view wx:if="{{activeLesson.terms && activeLesson.terms.length}}" class="lesson-terms">
        <view class="lesson-terms-title">📖 术语</view>
        <view wx:for="{{activeLesson.terms}}" wx:key="term" class="term-item">
          <text class="term-name">{{item.term}}</text>
          <text class="term-def">{{item.def}}</text>
        </view>
      </view>

      <view wx:if="{{activeLesson.tileGroups.length}}" class="lesson-tile-groups">
        <view wx:for="{{activeLesson.tileGroups}}" wx:key="label" class="tile-group">
          <view class="tile-group-label">{{item.label}}</view>
          <view class="tile-row-inline">
            <image
              wx:for="{{item.displayTiles}}"
              wx:key="id"
              class="lesson-tile-img"
              src="{{item.src}}"
              mode="aspectFit"
            />
            <image
              wx:if="{{item.winTile}}"
              class="lesson-tile-img lesson-win-tile {{item.winTile.id === '5z' ? 'haku-tile' : ''}}"
              src="{{item.winTile.src}}"
              mode="aspectFit"
            />
          </view>
        </view>
      </view>

      <view wx:if="{{activeLesson.tip}}" class="lesson-tip">
        <text class="tip-icon">💡</text>
        <text>{{activeLesson.tip}}</text>
      </view>

      <view wx:if="{{activeLesson.check}}" class="lesson-check-card">
        <view class="lesson-check-heading">
          <view>
            <view class="lesson-check-kicker">章末小测</view>
            <view class="lesson-check-title">答对后标记本章已学会</view>
          </view>
          <view wx:if="{{activeLessonLearned}}" class="lesson-learned-badge">已学会 ✓</view>
        </view>
        <view class="lesson-check-question">{{activeLesson.check.question}}</view>
        <view class="quiz-options lesson-check-options">
          <view
            wx:for="{{activeLesson.check.options}}"
            wx:key="*this"
            class="quiz-option {{lessonCheckAnswer === index ? 'selected' : ''}} {{lessonCheckSubmitted && index === activeLesson.check.answer ? 'correct' : ''}} {{lessonCheckSubmitted && lessonCheckAnswer === index && !lessonCheckCorrect ? 'wrong' : ''}}"
            data-answer="{{index}}"
            bindtap="selectLessonCheckOption"
          >
            <text class="option-letter">{{['A','B','C','D'][index]}}</text>
            <text class="option-text">{{item}}</text>
          </view>
        </view>
        <view wx:if="{{lessonCheckSubmitted}}" class="quiz-explanation lesson-check-explanation">
          <view class="quiz-explanation-header {{lessonCheckCorrect ? 'correct' : 'wrong'}}">
            {{lessonCheckCorrect ? '✅ 回答正确，本章已学会！' : '❌ 还差一点，再想想'}}
          </view>
          <view class="quiz-explanation-text">{{lessonCheckExplanation}}</view>
          <button wx:if="{{!lessonCheckCorrect}}" class="btn btn-secondary" bindtap="retryLessonCheck">重新作答</button>
        </view>
        <view wx:if="{{!lessonCheckSubmitted}}" class="quiz-submit-area">
          <button class="btn" bindtap="submitLessonCheck" disabled="{{lessonCheckAnswer < 0}}">确认答案</button>
        </view>
      </view>
      <view class="lesson-scroll-gap"></view>
    </scroll-view>
  </view>
</view>

<!-- 测验弹窗 -->
<view wx:if="{{showQuiz}}" class="overlay tab-safe-overlay">
  <view class="tutorial-modal quiz-modal">
    <view class="modal-close" bindtap="closeQuiz">✕</view>

    <view class="quiz-topic-heading">
      <view class="quiz-topic-title">{{activeTraining.title}}</view>
      <view class="quiz-topic-desc">{{activeTraining.description}}</view>
    </view>

    <block wx:if="{{!showQuizResult}}">
      <!-- 进度 -->
      <view class="quiz-progress">
        <text>第 {{quizIndex + 1}} / {{quizQuestions.length}} 题</text>
        <view class="quiz-progress-bar">
          <view class="quiz-progress-fill" style="width: {{(quizIndex + 1) / quizQuestions.length * 100}}%"></view>
        </view>
      </view>

      <!-- 题目 -->
      <view class="quiz-question">{{quizQuestions[quizIndex].question}}</view>

      <!-- 选项 -->
      <view class="quiz-options">
        <view
          wx:for="{{quizQuestions[quizIndex].options}}"
          wx:key="*this"
          class="quiz-option {{quizAnswer === index ? 'selected' : ''}} {{quizSubmitted && index === quizQuestions[quizIndex].answer ? 'correct' : ''}} {{quizSubmitted && quizAnswer === index && !quizCorrect ? 'wrong' : ''}}"
          data-answer="{{index}}"
          bindtap="selectQuizOption"
        >
          <text class="option-letter">{{['A','B','C','D'][index]}}</text>
          <text class="option-text">{{item}}</text>
        </view>
      </view>

      <!-- 解析 -->
      <view wx:if="{{quizSubmitted}}" class="quiz-explanation">
        <view class="quiz-explanation-header {{quizCorrect ? 'correct' : 'wrong'}}">
          {{quizCorrect ? '✅ 回答正确！' : '❌ 回答错误'}}
        </view>
        <view class="quiz-explanation-text">{{quizExplanation}}</view>
        <button class="btn" bindtap="nextQuizQuestion">
          {{quizIndex + 1 >= quizQuestions.length ? '查看成绩' : '下一题'}}
        </button>
      </view>

      <!-- 提交 -->
      <view wx:if="{{!quizSubmitted}}" class="quiz-submit-area">
        <button class="btn" bindtap="submitQuizAnswer" disabled="{{quizAnswer < 0}}">确认答案</button>
      </view>
    </block>

    <!-- 成绩 -->
    <block wx:if="{{showQuizResult}}">
      <view class="quiz-result">
        <view class="quiz-result-score">{{quizScore}} / {{quizQuestions.length}}</view>
        <view class="quiz-result-label">{{activeTraining.title}} · 本次得分</view>
        <view class="quiz-result-text">{{quizResultText}}</view>
      </view>
      <view class="lesson-modal-actions">
        <button class="btn btn-secondary" bindtap="closeQuiz">返回</button>
        <button class="btn" bindtap="restartQuiz">再做一次</button>
      </view>
    </block>
  </view>
</view>
