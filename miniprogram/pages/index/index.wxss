/* pages/index/index.wxss */
@import "/utils/common.wxss";

.room-banner { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; padding: 20rpx 24rpx; border: 2rpx solid #ded8c8; border-radius: 20rpx; background: #fffdf7; }
.room-banner.active { border-color: #8fa07e; background: #f1f6ec; }
.room-banner.offline { border-color: #c8a68f; background: #fff7f0; }
.room-banner-main { display: flex; flex-direction: column; gap: 5rpx; min-width: 0; }
.room-banner-title { color: #3d3929; font-size: 28rpx; font-weight: 700; letter-spacing: 1rpx; }
.room-banner-status { color: #8a8470; font-size: 21rpx; }
.room-banner-action { color: #c96442; font-size: 24rpx; white-space: nowrap; }
.room-write-warning { margin: 18rpx 0; padding: 16rpx 20rpx; border-radius: 14rpx; background: #fff0e8; color: #9b593f; font-size: 22rpx; text-align: center; }

.room-config-hint { margin-bottom: 22rpx; padding: 20rpx; border-radius: 16rpx; background: #fff3df; color: #815f31; font-size: 23rpx; line-height: 1.7; }
.code-text { font-family: monospace; color: #9b4c31; }
.room-mode-tabs { margin-bottom: 20rpx; }
.room-privacy-hint { margin-top: 10rpx; color: #98917d; font-size: 21rpx; line-height: 1.6; }
.room-seat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; margin-top: 10rpx; }
.room-seat-option { display: flex; flex-direction: column; align-items: center; gap: 6rpx; min-width: 0; padding: 18rpx 8rpx; border: 2rpx solid #dfd9ca; border-radius: 16rpx; background: #fff; color: #706a58; font-size: 21rpx; }
.room-seat-option.active { border-color: #c96442; background: #fff1e9; color: #9a442b; box-shadow: inset 0 0 0 2rpx rgba(201,100,66,.12); }
.room-seat-option.occupied { opacity: .55; background: #ece9e0; }
.room-seat-option.occupied.active { border-color: #dfd9ca; box-shadow: none; }
.room-seat-wind { font-size: 30rpx; font-weight: 700; }
.room-primary { width: 100%; margin-top: 28rpx; }
.room-close { width: 100%; margin-top: 18rpx; }
.room-code-row { display: flex; align-items: stretch; gap: 12rpx; }
.room-code-row .room-code-input { flex: 1; min-width: 0; letter-spacing: 8rpx; text-transform: uppercase; font-family: monospace; font-size: 30rpx; }
.room-code-row button { width: 150rpx; margin: 0; }
.room-preview-title { margin-top: 24rpx; color: #5f5947; font-size: 24rpx; font-weight: 700; }
.room-full-hint { margin-top: 14rpx; padding: 14rpx 16rpx; border-radius: 12rpx; background: #fff3df; color: #8a6439; font-size: 21rpx; line-height: 1.6; }
.room-current-status { margin-bottom: 18rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #eef5e8; color: #536349; font-size: 22rpx; line-height: 1.7; }
.room-current-status.ended { background: #ece9e0; color: #77705f; }
.room-code-card { display: flex; align-items: baseline; justify-content: center; gap: 16rpx; margin-bottom: 16rpx; padding: 24rpx; border: 2rpx dashed #c96442; border-radius: 18rpx; background: #fffaf5; }
.room-code-label, .room-code-copy { color: #918a77; font-size: 20rpx; }
.room-code-value { color: #c96442; font-family: monospace; font-size: 40rpx; font-weight: 700; letter-spacing: 7rpx; }
.room-member-list { border: 2rpx solid #e2dccd; border-radius: 16rpx; overflow: hidden; background: #fff; }
.room-member-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; padding: 10rpx 18rpx; border-bottom: 2rpx solid #eee9dd; font-size: 24rpx; }
.room-member-row:last-child { border-bottom: 0; }
.room-member-seat { display: inline-flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; margin-right: 14rpx; border-radius: 50%; background: #f1ede2; color: #c96442; font-weight: 700; }
.room-me-mark { margin-left: 10rpx; padding: 3rpx 10rpx; border-radius: 12rpx; background: #e8f2df; color: #567145; font-size: 18rpx; }
.room-empty-mark { color: #aaa28f; font-size: 21rpx; }
.room-release-btn { width: auto !important; min-height: 0; margin: 0; padding: 8rpx 14rpx; border: 0; border-radius: 12rpx; background: #eee9df; color: #8a6658; font-size: 20rpx; line-height: 1.3; }
.room-release-btn::after { border: 0; }
.room-last-action { margin-top: 18rpx; padding: 16rpx 18rpx; border-radius: 14rpx; background: #f6f3eb; color: #77705f; font-size: 22rpx; }
.room-panel-close { position: sticky; top: -18rpx; }
.room-actions { margin-top: 24rpx; flex-direction: column; }
.room-management-row { display: flex; gap: 14rpx; width: 100%; }
.room-management-row .btn { flex: 1; min-width: 0; }
.room-panel-dismiss { width: 100%; margin: 0; }
.modal-actions { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }

.actions { display: flex; flex-direction: column; gap: 14rpx; }

/* 和牌面板 */
.win-modal { max-height: 92vh; }

/* 和牌分步向导 */
.win-steps { display: flex; align-items: center; gap: 10rpx; margin-bottom: 22rpx; }
.win-step-btn { display: flex; align-items: center; gap: 8rpx; color: #8a8470; padding: 8rpx 10rpx; border-radius: 12rpx; }
.win-step-btn.active { color: #c96442; }
.win-step-btn.active .win-step-num { background: #c96442; border-color: #c96442; color: #fff; }
.win-step-num { width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; border: 2rpx solid #ddd7c8; border-radius: 50%; font-size: 24rpx; font-weight: 700; box-sizing: border-box; }
.win-step-label { font-size: 24rpx; font-weight: 600; }
.win-step-line { flex: 1; height: 6rpx; border-radius: 6rpx; background: #e0dbcd; }
.win-step-line.on { background: #c96442; }
.hand-box { min-height: 68rpx; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 14rpx; padding: 6rpx 10rpx; display: flex; flex-wrap: nowrap; gap: 3rpx; align-items: center; overflow: hidden; }
.hand-tile { flex: 1 1 0; min-width: 0; max-width: 54rpx; height: 72rpx; object-fit: contain; border-radius: 5rpx; }
.hand-tile:active { transform: scale(.9); }
.hand-tile.win-tile { box-shadow: inset 0 0 0 5rpx #5a7a4a, 0 0 0 2rpx #5a7a4a; }
.empty-hint { color: #b8b299; font-size: 24rpx; width: 100%; text-align: center; }

.win-tile-picker { display: flex; flex-wrap: nowrap; gap: 4rpx; padding: 6rpx 10rpx; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 18rpx; min-height: 68rpx; overflow: hidden; align-items: center; }
.win-option { flex: 1 1 0; min-width: 0; max-width: 56rpx; aspect-ratio: 30/41; border: 4rpx solid transparent; border-radius: 8rpx; padding: 2rpx; }
.win-option.active { border-color: #5a7a4a; box-shadow: 0 0 0 4rpx rgba(90,122,74,.16); }

.tile-keyboard { display: flex; flex-direction: column; gap: 10rpx; margin-top: 14rpx; }
.tile-row { display: flex; gap: 6rpx; justify-content: center; }
.tile-key { position: relative; flex: 1; max-width: 80rpx; aspect-ratio: 3/4; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 10rpx; padding: 4rpx; display: flex; align-items: center; justify-content: center; }
.tile-key:active { transform: scale(.92); }
.tile-key.disabled { opacity: .3; }
.count-badge { position: absolute; top: -4rpx; right: -4rpx; background: #c96442; color: #fff; font-size: 18rpx; width: 28rpx; height: 28rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; z-index: 1; }

.fold-title { background: #ede8db; border-radius: 18rpx; padding: 20rpx; margin-top: 20rpx; font-size: 26rpx; color: #3d3929; }
.picker-grid { display: grid; grid-template-columns: repeat(9, 1fr); gap: 6rpx; margin-top: 10rpx; }
.mini-option { aspect-ratio: 1; background: #fff; border: 3rpx solid transparent; border-radius: 8rpx; padding: 3rpx; }
.mini-option.active { border-color: #c96442; background: #fdf1eb; }

.analyze-btn { margin-top: 28rpx; background: #5a7a4a !important; }
.analysis-message { margin-top: 16rpx; padding: 20rpx; background: #fff8e8; border-radius: 16rpx; font-size: 24rpx; color: #8a7070; }

.analysis-options { margin-top: 28rpx; }
.meld-row { background: #fff; border: 2rpx solid #e8e5d8; border-radius: 14rpx; padding: 16rpx; margin-bottom: 14rpx; }
.meld-tiles { display: flex; gap: 4rpx; }
.meld-tile { width: 48rpx; height: 64rpx; }
.meld-modes { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.mode { padding: 12rpx 18rpx; border: 2rpx solid #d8d1c0; border-radius: 12rpx; background: #faf8f2; font-size: 22rpx; }
.mode.active, .condition.active { background: #c96442; color: #fff; border-color: #c96442; }
.condition-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.condition { padding: 14rpx 20rpx; border: 2rpx solid #d8d1c0; border-radius: 14rpx; background: #faf8f2; font-size: 24rpx; }
.condition.disabled { opacity: .35; }

.result-card { margin-top: 20rpx; background: #fff; border: 2rpx solid #d8d1c0; border-radius: 24rpx; padding: 28rpx; line-height: 1.8; font-size: 26rpx; }
.result-title { font-size: 32rpx; font-weight: 700; margin-bottom: 10rpx; }
.score-line { font-size: 38rpx; font-weight: 700; color: #c96442; margin: 14rpx 0 6rpx; }
.payment-line { color: #716b59; font-size: 24rpx; }

.history-list { margin-top: 20rpx; }
.room-history-item { display: block; }
.room-history-summary { color: #4c4738; font-size: 23rpx; line-height: 1.5; }
.room-history-meta { margin-top: 5rpx; color: #9a927f; font-size: 19rpx; }

.loser-row { margin-bottom: 0; }
.manual-score-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.manual-score-field { flex: 1; min-width: 0; }
.compact-label { margin-top: 0; }
.picker-control { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 20rpx; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 14rpx; color: #3d3929; font-size: 26rpx; }
.picker-arrow { color: #c96442; font-size: 28rpx; }
