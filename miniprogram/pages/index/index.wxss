.page { padding: 24rpx; padding-bottom: 80rpx; }
.round-card, .history-card { background: #fffdf7; border: 1rpx solid #ded8c8; border-radius: 20rpx; padding: 24rpx; display: flex; justify-content: space-between; align-items: center; }
.round-title { font-size: 42rpx; font-weight: 700; }.sub-info,.hint,.empty { color: #8a8470; font-size: 24rpx; }.round-seat { color: #c46645; font-weight: 700; }
.players { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 20rpx 0; }.player-card { position: relative; background: #fff; border: 2rpx solid #e4dfd1; border-radius: 18rpx; padding: 20rpx; }.player-card.dealer { border-color: #c46645; }.player-card.riichi { background: #fff8f1; }.seat { color:#8a8470;font-size:23rpx}.player-name{margin:6rpx 0}.points{font-size:38rpx;font-weight:700}.riichi-dot{position:absolute;right:16rpx;top:14rpx;color:#c46645}
.actions { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }.actions button,.inline-actions button,.modal-actions button { margin:0; background:#fff; border:1rpx solid #ddd7c8; font-size:27rpx }.primary,.actions .primary,.modal-actions .primary { background:#c46645;color:#fff;border-color:#c46645 }.reset{margin-top:24rpx;background:transparent;color:#9a9483;font-size:24rpx}.history-card{display:block;margin-top:20rpx}.section-title{font-weight:700;margin-bottom:12rpx}.history-item{display:flex;justify-content:space-between;border-top:1rpx solid #eee9dc;padding:12rpx 0}
.overlay { position:fixed;inset:0;background:rgba(49,45,34,.48);z-index:20;display:flex;align-items:flex-end }.modal { width:100%;max-height:94vh;background:#f8f4e9;border-radius:28rpx 28rpx 0 0;padding:28rpx;box-sizing:border-box }.modal.small{margin:auto 24rpx;border-radius:24rpx;height:auto}.modal-title{font-size:36rpx;font-weight:700;text-align:center;margin-bottom:22rpx}.label,.label-row{font-size:24rpx;color:#746e5c;margin:18rpx 0 8rpx}.label-row{display:flex;justify-content:space-between}.segments{display:flex;flex-wrap:wrap;gap:10rpx}.segment{flex:1;min-width:120rpx;text-align:center;padding:15rpx 10rpx;background:#fff;border:1rpx solid #ded8c8;border-radius:12rpx}.segment.active,.condition.active,.mode.active,.mini-option.active,.win-option.active{background:#c46645;color:#fff;border-color:#c46645}.disabled{opacity:.35;pointer-events:none}
.hand-box,.win-picker{min-height:92rpx;background:#fff;border:1rpx solid #ded8c8;border-radius:14rpx;padding:12rpx;display:flex;flex-wrap:wrap;gap:6rpx;align-items:center}.hand-tile{width:52rpx;height:70rpx;border-radius:5rpx}.hand-tile.win-tile{outline:5rpx solid #58764a}.win-option{width:48rpx;height:65rpx;border:3rpx solid transparent;border-radius:7rpx;padding:2rpx}.tile-image{width:100%;height:100%}.haku{background:#fffef9;border:2rpx solid #8f8a7c;border-radius:5rpx;box-sizing:border-box;box-shadow:0 2rpx 4rpx rgba(50,45,32,.18)}
.keyboard{margin-top:14rpx}.tile-row{display:flex;gap:5rpx;margin-bottom:6rpx}.tile-key{position:relative;flex:1;height:80rpx;background:#fff;border:1rpx solid #ded8c8;border-radius:8rpx;padding:3rpx}.badge{position:absolute;right:-4rpx;top:-5rpx;width:28rpx;height:28rpx;border-radius:50%;background:#c46645;color:#fff;font-size:18rpx;text-align:center;line-height:28rpx}.inline-actions,.modal-actions{display:flex;gap:12rpx;margin-top:16rpx}.inline-actions button,.modal-actions button{flex:1}
.fold-title{background:#ede8db;border-radius:10rpx;padding:15rpx;margin-top:14rpx}.picker-grid{display:grid;grid-template-columns:repeat(9,1fr);gap:5rpx;margin-top:8rpx}.mini-option{height:68rpx;background:#fff;border:2rpx solid transparent;border-radius:6rpx;padding:2rpx}.analysis-options{margin-top:20rpx}.meld-row{background:#fff;border:1rpx solid #ded8c8;border-radius:14rpx;padding:12rpx;margin-bottom:10rpx}.meld-tiles{display:flex;gap:4rpx}.meld-tile{width:46rpx;height:62rpx}.meld-modes,.condition-grid{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:10rpx}.mode,.condition{padding:9rpx 13rpx;border:1rpx solid #d8d1c0;border-radius:9rpx;background:#faf8f2;font-size:22rpx}.analyze{margin-top:20rpx;background:#58764a;color:#fff}.analysis-message{margin-top:12rpx;padding:15rpx;background:#fff8e8;border-radius:10rpx}.result-card{margin-top:14rpx;background:#fff;border:1rpx solid #d8d1c0;border-radius:16rpx;padding:20rpx;line-height:1.8}.result-title{font-size:32rpx;font-weight:700}.score-line{font-size:34rpx;font-weight:700;color:#c46645}.payment{color:#716b59}
