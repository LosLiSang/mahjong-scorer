/* pages/index/index.wxss */
@import "/utils/common.wxss";

.actions { display: flex; flex-direction: column; gap: 14rpx; }

/* 和牌面板 */
.win-modal { max-height: 92vh; }
.hand-box { min-height: 68rpx; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 14rpx; padding: 6rpx 10rpx; display: flex; flex-wrap: nowrap; gap: 3rpx; align-items: center; overflow: hidden; }
.hand-tile { flex: 1 1 0; min-width: 0; max-width: 54rpx; height: 72rpx; object-fit: contain; border-radius: 5rpx; }
.hand-tile:active { transform: scale(.9); }
.hand-tile.win-tile { box-shadow: inset 0 0 0 5rpx #5a7a4a, 0 0 0 2rpx #5a7a4a; }
.empty-hint { color: #b8b299; font-size: 24rpx; width: 100%; text-align: center; }

.win-tile-picker { display: flex; flex-wrap: nowrap; gap: 4rpx; padding: 6rpx 10rpx; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 18rpx; min-height: 68rpx; overflow: hidden; align-items: center; }
.win-option { flex: 1 1 0; min-width: 0; max-width: 56rpx; aspect-ratio: 30/41; border: 4rpx solid transparent; border-radius: 8rpx; padding: 2rpx; }
.win-option.active { border-color: #5a7a4a; box-shadow: 0 0 0 4rpx rgba(90,122,74,.16); }

.tile-keyboard { display: flex; flex-direction: column; gap: 10rpx; margin-top: 14rpx; }
.tile-row { display: flex; gap: 6rpx; justify-content: center; }
.tile-key { position: relative; flex: 1; max-width: 80rpx; aspect-ratio: 3/4; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 10rpx; padding: 4rpx; display: flex; align-items: center; justify-content: center; }
.tile-key:active { transform: scale(.92); }
.tile-key.disabled { opacity: .3; }
.count-badge { position: absolute; top: -4rpx; right: -4rpx; background: #c96442; color: #fff; font-size: 18rpx; width: 28rpx; height: 28rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; z-index: 1; }

.fold-title { background: #ede8db; border-radius: 18rpx; padding: 20rpx; margin-top: 20rpx; font-size: 26rpx; color: #3d3929; }
.picker-grid { display: grid; grid-template-columns: repeat(9, 1fr); gap: 6rpx; margin-top: 10rpx; }
.mini-option { aspect-ratio: 1; background: #fff; border: 3rpx solid transparent; border-radius: 8rpx; padding: 3rpx; }
.mini-option.active { border-color: #c96442; background: #fdf1eb; }

.analyze-btn { margin-top: 28rpx; background: #5a7a4a !important; }
.analysis-message { margin-top: 16rpx; padding: 20rpx; background: #fff8e8; border-radius: 16rpx; font-size: 24rpx; color: #8a7070; }

.analysis-options { margin-top: 28rpx; }
.meld-row { background: #fff; border: 2rpx solid #e8e5d8; border-radius: 14rpx; padding: 16rpx; margin-bottom: 14rpx; }
.meld-tiles { display: flex; gap: 4rpx; }
.meld-tile { width: 48rpx; height: 64rpx; }
.meld-modes { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.mode { padding: 12rpx 18rpx; border: 2rpx solid #d8d1c0; border-radius: 12rpx; background: #faf8f2; font-size: 22rpx; }
.mode.active, .condition.active { background: #c96442; color: #fff; border-color: #c96442; }
.condition-grid { display: flex; flex-wrap: wrap; gap: 10rpx; }
.condition { padding: 14rpx 20rpx; border: 2rpx solid #d8d1c0; border-radius: 14rpx; background: #faf8f2; font-size: 24rpx; }
.condition.disabled { opacity: .35; }

.result-card { margin-top: 20rpx; background: #fff; border: 2rpx solid #d8d1c0; border-radius: 24rpx; padding: 28rpx; line-height: 1.8; font-size: 26rpx; }
.result-title { font-size: 32rpx; font-weight: 700; margin-bottom: 10rpx; }
.score-line { font-size: 38rpx; font-weight: 700; color: #c96442; margin: 14rpx 0 6rpx; }
.payment-line { color: #716b59; font-size: 24rpx; }

.history-list { margin-top: 20rpx; }

.loser-row { margin-bottom: 0; }
.manual-score-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.manual-score-field { flex: 1; min-width: 0; }
.compact-label { margin-top: 0; }
.picker-control { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 20rpx; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 14rpx; color: #3d3929; font-size: 26rpx; }
.picker-arrow { color: #c96442; font-size: 28rpx; }
