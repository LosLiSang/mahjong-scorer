.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  height: calc(108rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: rgba(250, 248, 242, .98);
  box-sizing: border-box;
  box-shadow: 0 -4rpx 24rpx rgba(61, 57, 41, .08);
  font-family: "Noto Serif SC", "Songti SC", Georgia, serif;
}

.tab-bar-border {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 1rpx;
  background: #e8e2d4;
}

.tab-item {
  flex: 1;
  min-width: 0;
  height: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #8a8470;
  font-family: "Noto Serif SC", "Songti SC", Georgia, serif;
}

.tab-mark {
  width: 42rpx;
  height: 42rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  line-height: 40rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.tab-text {
  font-family: "Noto Serif SC", "Songti SC", Georgia, serif;
  font-size: 22rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.tab-item.selected {
  color: #c46645;
}

.tab-item.selected .tab-mark {
  color: #fff;
  background: #c46645;
  border-color: #c46645;
  box-shadow: 0 3rpx 10rpx rgba(196, 102, 69, .25);
}
