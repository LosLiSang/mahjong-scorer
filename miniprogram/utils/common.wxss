/* common.wxss — 日麻计分器 · 共享样式 */

/* 基础 */
page { background: #f5f4ee; color: #3d3929; font-family: "Noto Serif SC", "Songti SC", Georgia, serif; }
view, text, button, input, textarea, picker, scroll-view {
  font-family: "Noto Serif SC", "Songti SC", Georgia, serif;
}
button::after { border: none; }
.container { padding: 24rpx; padding-bottom: 120rpx; }
.rights-banner { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 28rpx; margin-bottom: 0; padding: 12rpx 16rpx; border: 1rpx solid #ded8c8; border-radius: 14rpx; background: rgba(250,249,243,.88); color: #746e5c; font-size: 20rpx; line-height: 1.35; }
.rights-owner { flex-shrink: 0; color: #c46645; font-weight: 700; white-space: nowrap; }
.rights-contact { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; }
.serif-input { font-family: "Noto Serif SC", "Songti SC", STSong, SimSun, Georgia, serif !important; }
.setup-name-input.serif-input { flex: 1; min-width: 0; height: 72rpx; line-height: 72rpx; padding: 0 16rpx; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 14rpx; color: #3d3929; font-size: 28rpx; box-sizing: border-box; }

/* 房间头像 */
.room-profile-picker-row { display: flex; align-items: center; gap: 16rpx; margin-top: 16rpx; }
.room-avatar-picker { flex: 0 0 auto; width: 92rpx !important; height: 92rpx; min-height: 0; margin: 0; padding: 0 !important; overflow: hidden; border: 2rpx solid #ddd7c8; border-radius: 50% !important; background: #f1eee5 !important; color: #8a8470 !important; line-height: 88rpx; }
.room-avatar-picker::after { border: 0; }
.room-avatar-picker.compact { width: 72rpx !important; height: 72rpx; line-height: 68rpx; }
.room-avatar-picker-image { display: block; width: 100%; height: 100%; border-radius: 50%; }
.room-avatar-picker-placeholder { font-size: 20rpx; font-weight: 600; }
.room-avatar-picker-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; }
.room-avatar-picker-title { color: #5f5947; font-size: 24rpx; font-weight: 700; }
.room-avatar-picker-desc { color: #98917d; font-size: 20rpx; line-height: 1.5; }
.room-current-avatar-row { display: flex; align-items: center; gap: 16rpx; margin: 0 0 18rpx; padding: 14rpx 16rpx; border-radius: 14rpx; background: #f6f3eb; color: #77705f; font-size: 21rpx; line-height: 1.5; }
.room-player-avatar { position: absolute; z-index: 2; top: 8rpx; left: 8rpx; display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; overflow: hidden; border: 2rpx solid rgba(255,255,255,.9); border-radius: 50%; background: #e9e4d8; color: #746e5c; font-size: 16rpx; font-weight: 700; box-shadow: 0 2rpx 6rpx rgba(61,57,41,.14); box-sizing: border-box; }
.room-player-avatar-image { display: block; width: 100%; height: 100%; }

/* 按钮 */
.btn { background: #c96442; color: #fff; border: none; padding: 28rpx; border-radius: 18rpx; font-size: 30rpx; font-weight: 600; }
.btn:active { opacity: 0.7; }
.btn-secondary { background: #e8e5d8; color: #3d3929; }
.btn-danger { background: #8a8470; color: #fff; }
.btn-small { padding: 16rpx 24rpx; font-size: 24rpx; }
.btn-row { display: flex; gap: 14rpx; }
.btn-row .btn { flex: 1; }
.hollow-btn { background: transparent; border: 1rpx solid #aaa28d; color: #746e5c; font-size: 24rpx; padding: 12rpx 20rpx; border-radius: 12rpx; }

/* 弹窗 */
.overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(49,45,34,.48); z-index: 1200; display: flex; align-items: center; justify-content: center; padding: 24rpx; box-sizing: border-box; }
.overlay-closable { z-index: 1200; }
/* 自定义 tabBar 作为独立组件层时可能盖住页面弹窗；tab 页面显式缩短遮罩与弹窗可用高度。 */
.tab-safe-overlay { bottom: calc(108rpx + env(safe-area-inset-bottom)); }
.tab-safe-overlay > .modal,
.tab-safe-overlay > .tutorial-modal { max-height: calc(100vh - 156rpx - env(safe-area-inset-bottom)); }
.tab-safe-scroll-modal { height: calc(100vh - 156rpx - env(safe-area-inset-bottom)); max-height: calc(100vh - 156rpx - env(safe-area-inset-bottom)); }
.modal { width: 100%; max-width: 680rpx; max-height: 90vh; background: #faf9f3; border-radius: 30rpx; padding: 36rpx; box-sizing: border-box; box-shadow: 0 18rpx 60rpx rgba(49,45,34,.24); }
.compact-modal { max-width: 540rpx; height: auto; }
.modal-title { font-size: 36rpx; font-weight: 700; text-align: center; margin-bottom: 28rpx; color: #3d3929; }
.modal-close { position: sticky; top: -18rpx; z-index: 3; float: right; width: 60rpx; height: 60rpx; margin: -18rpx -16rpx 8rpx 16rpx; border: 2rpx solid #ddd7c8; border-radius: 50%; background: rgba(250,249,243,.96); color: #746e5c; font-size: 40rpx; line-height: 56rpx; text-align: center; }
.modal h3 { text-align: center; margin-bottom: 28rpx; font-weight: 700; color: #3d3929; }
.modal-actions { display: flex; gap: 14rpx; margin-top: 28rpx; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.modal-actions .btn { flex: 1; }

/* seg-group 分段选择 */
.seg-group { display: flex; gap: 10rpx; flex-wrap: wrap; }
.seg-btn { flex: 1; min-width: 120rpx; padding: 18rpx 14rpx; background: #fff; border: 2rpx solid #e8e5d8; border-radius: 14rpx; color: #3d3929; text-align: center; font-size: 26rpx; }
.seg-btn.active { background: #c96442; border-color: #c96442; color: #fff; }
.seg-btn.disabled { opacity: .35; }
/* 座位等一排按钮：去掉最小宽度，让 4 个按钮排成一行（避免折成 3+1） */
.seg-group.seg-one-line .seg-btn { min-width: 0; }
label, .label { display: block; font-size: 24rpx; color: #8a8470; margin: 24rpx 0 10rpx; font-weight: 500; }
.label-row { display: flex; justify-content: space-between; font-size: 24rpx; color: #8a8470; margin: 18rpx 0 8rpx; }

/* 牌图 */
.tile-img { width: 100%; height: 100%; object-fit: contain; display: block; }
.haku-tile { background: #fffef9; border: 2rpx solid #8f8a7c; border-radius: 6rpx; box-sizing: border-box; box-shadow: 0 2rpx 4rpx rgba(50,45,32,.18); }

/* 结果卡片 */
.result-box { background: #fff; border: 2rpx solid #e8e5d8; border-radius: 18rpx; padding: 24rpx; margin: 24rpx 0; text-align: center; }
.result-box .points { font-size: 48rpx; font-weight: 700; color: #5a7a4a; }
.result-box .detail { font-size: 24rpx; color: #8a8470; margin-top: 10rpx; }
.result-box .breakdown { font-size: 22rpx; color: #8a8470; margin-top: 12rpx; line-height: 1.8; white-space: pre-line; }

/* 历史 */
.history-item { background: #fff; border: 2rpx solid #e8e5d8; padding: 16rpx 20rpx; border-radius: 14rpx; margin-bottom: 8rpx; font-size: 22rpx; color: #8a8470; display: flex; justify-content: space-between; }
.history-item .who { color: #c96442; font-weight: 700; }

/* 极简四向牌桌 */
.table-board {
  position: relative;
  height: 560rpx;
  margin-bottom: 26rpx;
  padding: 14rpx;
  border: 2rpx solid #d9d4c8;
  border-radius: 28rpx;
  background:
    linear-gradient(90deg, transparent calc(50% - 1rpx), #e8e3d9 calc(50% - 1rpx), #e8e3d9 calc(50% + 1rpx), transparent calc(50% + 1rpx)),
    linear-gradient(transparent calc(50% - 1rpx), #e8e3d9 calc(50% - 1rpx), #e8e3d9 calc(50% + 1rpx), transparent calc(50% + 1rpx)),
    #faf9f5;
  box-shadow: 0 8rpx 28rpx rgba(61,57,41,.07), inset 0 0 0 8rpx rgba(255,255,255,.58);
  box-sizing: border-box;
}
.table-corner { position: absolute; z-index: 2; display: flex; flex-direction: column; gap: 2rpx; min-width: 96rpx; color: #918a78; line-height: 1.25; pointer-events: none; }
.corner-tl { top: 20rpx; left: 22rpx; align-items: flex-start; }
.corner-tr { top: 20rpx; right: 22rpx; align-items: flex-end; }
.corner-bl { bottom: 20rpx; left: 22rpx; align-items: flex-start; }
.corner-br { right: 22rpx; bottom: 20rpx; align-items: flex-end; }
.corner-label { font-size: 17rpx; letter-spacing: 2rpx; }
.corner-value { color: #5f594a; font-size: 22rpx; font-weight: 700; font-variant-numeric: tabular-nums; }
.table-center { position: absolute; z-index: 3; left: 50%; top: calc(50% + 20rpx); width: 172rpx; height: 140rpx; min-height: 0; transform: translate3d(-50%, -50%, 0); box-sizing: border-box; display: flex; flex-direction: column; justify-content: center; align-items: center; background: rgba(255,255,255,.96); border: 2rpx solid #dcd6ca; border-radius: 18rpx; padding: 10rpx; box-shadow: 0 0 18rpx rgba(61,57,41,.09); }
.center-kicker { color: #aaa28e; font-size: 15rpx; line-height: 1.2; letter-spacing: 3rpx; }
.table-center .round-info { color: #c46645; font-size: 29rpx; font-weight: 700; line-height: 1.25; }
.table-center .sub-info { max-width: 100%; margin-top: 3rpx; overflow: hidden; color: #746e5c; font-size: 17rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }
.center-rule { margin-top: 3rpx; padding: 2rpx 8rpx; border-radius: 8rpx; background: #f1eee5; color: #847d6c; font-size: 14rpx; line-height: 1.2; }
.player-card { position: absolute; z-index: 4; left: 50%; top: 50%; width: 196rpx; min-height: 98rpx; margin-left: -98rpx; margin-top: -49rpx; box-sizing: border-box; background: rgba(255,255,255,.94); border: 2rpx solid #ddd8cd; border-radius: 16rpx; padding: 11rpx 12rpx; text-align: center; box-shadow: 0 4rpx 14rpx rgba(61,57,41,.07); transition: transform .42s ease, border-color .2s ease, background-color .2s ease, box-shadow .2s ease; }
.player-card.seat-dong { transform: translate3d(0, 174rpx, 0); }
.player-card.seat-nan { transform: translate3d(220rpx, 0, 0); }
.player-card.seat-xi { transform: translate3d(0, -174rpx, 0); }
.player-card.seat-bei { transform: translate3d(-220rpx, 0, 0); }
.player-card.dealer { border-color: #c46645; box-shadow: 0 5rpx 16rpx rgba(196,102,69,.13), inset 0 4rpx 0 #c46645; }
.player-card.riichi { border-color: #d9a493; background: #fff9f6; }
.player-card .seat-label { color: #9a927f; font-size: 18rpx; font-weight: 600; letter-spacing: 1rpx; }
.player-card .name { max-width: 100%; margin: 4rpx 0 2rpx; overflow: hidden; color: #4b4638; font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.player-card .points { color: #2f2c24; font-size: 34rpx; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: .5rpx; }
.player-card .delta { color: #5a7a4a; font-size: 20rpx; height: 26rpx; }
.player-card .delta.minus { color: #c96442; }
.player-card .riichi-mark { position: absolute; top: 8rpx; right: 9rpx; padding: 2rpx 8rpx; border-radius: 8rpx; background: #c46645; color: #fff; font-size: 15rpx; }

/* 工具栏 */
.toolbar { display: flex; gap: 14rpx; margin-top: 20rpx; }
.toolbar .btn { flex: 1; }
